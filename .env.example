HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATA_DIR=./data
NODE_ENV=development
TRUST_PROXY=false
# Production: use NODE_ENV=production and an https:// APP_ORIGIN behind a TLS proxy.
# Set HOST=0.0.0.0 inside a container. Never expose the development server publicly.
# Only enable TRUST_PROXY behind a trusted proxy with the backend inaccessible directly.
